{
  "name": "Keystream",
  "version": "1.0.0",
  "description": "An enjoyable tool for the typing enthusiasts.",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dist-linux": "electron-builder --linux AppImage",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "ParameshRajan",
  "license": "ISC",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "electron-icon-builder": "^2.0.1"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "electron-squirrel-startup": "^1.0.1"
  },
  "build": {
    "appId": "com.paramesh.typingvisualizer",
    "productName": "Keystream",
    "asar": true,
    "compression": "maximum",
    "icon": "build/icons/1024x1024",
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/app/dist",
      "!**/app/node_modules",
      "!**/app/out",
      "!**/yarn.lock",
      "!**/package-lock.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "ParameshRajan@protonmail.com",
      "vendor": "ParameshRajan",
      "synopsis": "An enjoyable typing visualizer tool"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    }
  }
}
