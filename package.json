{
  "dependencies": {
    "mathjs": "^15.2.0"
  },
  "name": "Keystream",
  "version": "1.0.2",
  "description": "An enjoyable typing visualizer.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.paramesh.keystream",
    "productName": "Keystream",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "appx",
      "icon": "src/logo.png"
    },
    "appx":{
      
    },
    "mac": {
      "target": "dmg",
      "icon": "src/logo.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "src/logo.png"
    }
  },
  "keywords": [],
  "author": "Paramesh Rajan",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  }
}
